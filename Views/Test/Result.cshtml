@model PersonalityTest.Models.PersonalityResult

@{
    ViewData["Title"] = "Result";
}

<div class="pt-page">
    <div class="pt-card text-center">

        <span class="pt-eyebrow">Your Result</span>
        <h1>Your Personality Type</h1>

        <h2 class="mt-4" style="color: var(--pt-purple);">@Model.Type</h2>
        <h3>@Model.Title</h3>
        <p class="mt-3">@Model.Description</p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            Take Test Again
        </a>

    </div>
</div>