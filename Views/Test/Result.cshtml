@model PersonalityTest.Models.PersonalityResult

<div class="pt-page">
  <div class="pt-card" style="max-width: 60rem;">
    <div class="row align-items-center">

      <div class="col-md-7 text-md-start text-center">
          <span class="pt-eyebrow">Your Result</span>
          <h1>Your Personality Type</h1>
          <h2 class="mt-3" style="color: var(--pt-purple);">@Model.Type</h2>
          <h3>@Model.Title</h3>
          <p class="mt-3">@Model.Description</p>

          <div class="pt-traits mt-4">
              @{
                  var rows = new (string Left, int LeftPct, int RightPct, string Right)[]
                  {
                      ("Extraverted", Model.PctE, Model.PctI, "Introverted"),
                      ("Intuitive",   Model.PctN, Model.PctS, "Observant"),
                      ("Thinking",    Model.PctT, Model.PctF, "Feeling"),
                      ("Judging",     Model.PctJ, Model.PctP, "Prospecting")
                  };
              }
              @foreach (var row in rows)
              {
                  <div class="pt-trait-row mb-3">
                      <div class="d-flex justify-content-between small mb-1">
                          <span>@row.Left @row.LeftPct%</span>
                          <span>@row.Right @row.RightPct%</span>
                      </div>
                      <div class="pt-trait-bar">
                          <div class="pt-trait-fill" style="width:@(row.LeftPct)%;"></div>
                      </div>
                  </div>
              }
          </div>

          <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Take Test Again</a>
      </div>

      <div class="col-md-5 text-center mt-4 mt-md-0">
          <img src="~/images/@(Model.Type).png" alt="@Model.Title" class="pt-result-img" />
      </div>

    </div>
  </div>
</div>