@model PersonalityTest.Models.TestViewModel

<div class="container mt-4">
    <h2 class="mb-4">16 Personalities Test</h2>

    <form asp-controller="Test" asp-action="Questions" method="post">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            <input type="hidden" asp-for="Questions[i].Id" />
            <input type="hidden" asp-for="Questions[i].Text" />
            <input type="hidden" asp-for="Questions[i].Category" />

            <div class="card mb-3 p-3 shadow-sm">
                <h5>Question @(i + 1)</h5>
                <p class="lead">@Model.Questions[i].Text</p>

                <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded">
                    <span class="text-danger fw-bold">Disagree</span>
                    <div>
                        @for (int val = 1; val <= 5; val++)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Answers[i]"
                                       value="@val"
                                       required />
                                <label class="form-check-label">@val</label>
                            </div>
                        }
                    </div>
                    <span class="text-success fw-bold">Agree</span>
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary btn-lg mt-3 mb-5">Submit Answers</button>
    </form>
</div>