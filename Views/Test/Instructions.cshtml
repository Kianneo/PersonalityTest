@{
    ViewData["Title"] = "Instructions";
}

<div class="pt-page">
    <div class="pt-card">
        <span class="pt-eyebrow">Before you begin</span>
        <h2>Instructions</h2>

        <ul>
            <li>Read each statement carefully.</li>
            <li>Select the answer that best describes you.</li>
            <li>Answer honestly.</li>
            <li>There are 16 questions in total.</li>
        </ul>

        <a asp-action="Questions" class="btn btn-primary">
            Begin Test
        </a>
    </div>
</div>