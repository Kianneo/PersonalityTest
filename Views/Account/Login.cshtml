@model PersonalityTest.Models.LoginModel
@{
    Layout = null; // disables the default layout for this page
}

<!-- Import Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        margin: 0;
        height: 100vh;
        font-family: 'Poppins', sans-serif;
        /* Comfortable gradient background */
        background: linear-gradient(135deg, #f0f4f8 0%, #e6e6fa 50%, #d8bfd8 100%);
        display: flex;
        justify-content: center; /* horizontal center */
        align-items: center; /* vertical center */
    }

    .login-box {
        width: 380px;
        padding: 35px;
        border-radius: 12px;
        background-color: rgba(255,255,255,0.95);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        text-align: center;
        transition: transform 0.2s ease-in-out;
    }

        .login-box:hover {
            transform: scale(1.03);
        }

        .login-box h1 {
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #800080; /* purple title */
        }

        .login-box p {
            font-size: 14px;
            color: #555;
            margin-bottom: 20px;
        }

    .form-label {
        font-weight: 600;
        color: #333;
        text-align: left;
        display: block;
        margin-bottom: 5px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #aaa;
        border-radius: 6px;
        margin-bottom: 15px;
        font-size: 14px;
    }

    .btn-login {
        width: 100%;
        background-color: #800080; /* purple button */
        color: #fff;
        border: none;
        padding: 12px;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        transition: background-color 0.3s, transform 0.2s;
    }

        .btn-login:hover {
            background-color: #4b004b; /* darker purple on hover */
            transform: translateY(-2px);
            cursor: pointer;
        }

    .error-message {
        color: #d32f2f;
        margin-top: 10px;
        font-size: 14px;
    }
</style>

<div class="login-box">
    <!-- Welcome Label -->
    <h1>Welcome to the Personality Test</h1>
    <p>Enter your credentials to begin...</p>

    <form asp-action="Login" method="post">
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>
        <button type="submit" class="btn-login">Login</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <p class="error-message">@ViewBag.Error</p>
    }
</div>
